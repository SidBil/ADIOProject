{
  "expo": {
    "name": "Adio",
    "slug": "adio-therapy",
    "scheme": "adio-therapy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF6EF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.adio-therapy"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.anonymous.adiotherapy"
    },
    "web": {
      "favicon": "./assets/favicon-02.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-av",
        {
          "microphonePermission": "Adio needs your microphone to listen to your answers."
        }
      ],
      "expo-web-browser"
    ]
  }
}
